#!/usr/bin/env bash
# Run a command in the OpenChamber agent sandbox.
#
#   sandbox run [--] <command...>
#
# Shared caches live under $SANDBOX_DATA/cache and persist between runs.
# A fresh per-run scratch directory is mounted at /tmp and removed on exit,
# so transient build artifacts never accumulate on the host.
set -euo pipefail

image="${SANDBOX_IMAGE:-openchamber-sandbox:latest}"
data="${SANDBOX_DATA:-/data/.db/openchamber/sandbox}"
cache="$data/cache"
runs="$data/tmp"

usage() {
    echo "usage: sandbox run [--] <command...>" >&2
    exit 2
}

[ "${1:-}" = run ] || usage
shift
[ "${1:-}" = -- ] && shift
[ "${#}" -ge 1 ] || usage

run_id="$(date +%Y%m%dT%H%M%S)-$$"
tmp="$runs/$run_id"
mkdir -p "$cache" \
    "$tmp/home" "$tmp/xdg-cache" "$tmp/xdg-config" "$tmp/xdg-data" "$tmp/xdg-state"
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT

docker run --rm -i \
    --user "$(id -u):$(id -g)" \
    -w "$PWD" \
    -v /repo:/repo \
    -v /home/core:/home/core \
    -v /data/.db/openchamber:/data/.db/openchamber \
    -v "$cache":/cache \
    -v "$tmp":/tmp \
    -e HOME=/tmp/home \
    -e TMPDIR=/tmp \
    -e XDG_CACHE_HOME=/tmp/xdg-cache \
    -e XDG_CONFIG_HOME=/tmp/xdg-config \
    -e XDG_DATA_HOME=/tmp/xdg-data \
    -e XDG_STATE_HOME=/tmp/xdg-state \
    "$image" "$@"
