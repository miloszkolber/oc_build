#!/usr/bin/env bash
# Host launcher. The container's Docker endpoint is a separate rootless daemon.
set -euo pipefail
image="${SANDBOX_IMAGE:-ghcr.io/miloszkolber/openchamber-sandbox:latest}"
data="${SANDBOX_DATA:-/data/.db/openchamber/sandbox}"
uid="${SANDBOX_UID:-1000}"
gid="${SANDBOX_GID:-1000}"
[[ "$uid" =~ ^[1-9][0-9]*$ && "$gid" =~ ^[1-9][0-9]*$ ]] || {
    echo 'sandbox: identity must be a non-root numeric UID/GID' >&2; exit 2;
}
[[ "$data" = /* && "$data" != / ]] || {
    echo 'sandbox: SANDBOX_DATA must be an absolute non-root path' >&2; exit 2;
}
# Do not inherit DOCKER_HOST, DOCKER_CONTEXT or a selected rootless context.
host_docker() { docker --host unix:///var/run/docker.sock "$@"; }

if [[ "${1:-}" = clean && $# = 1 ]]; then
    [[ -d "$data/tmp" ]] || exit 0
    while IFS= read -r -d '' dir; do
        # The same flock is held throughout an active run, even beyond 24h.
        (
            exec 9>"$dir/.lock"
            flock -n 9 || exit 0
            name="sandbox-$(basename "$dir")"
            # Remove an orphan container before removing the path it mounts.
            host_docker info >/dev/null 2>&1 || exit 1
            if host_docker container inspect "$name" >/dev/null 2>&1; then
                host_docker rm --force "$name" >/dev/null || exit 1
            fi
            rm -rf -- "$dir"
        ) || exit 1
    done < <(find "$data/tmp" -mindepth 1 -maxdepth 1 -type d -name 'run-*' -mmin +1440 -print0)
    exit 0
fi

[[ "${1:-}" = run ]] || { echo 'usage: sandbox run [--publish host:container] [--] <command...> | sandbox clean' >&2; exit 2; }
shift
ports=()
while [[ "${1:-}" = --publish ]]; do
    mapping="${2:-}"
    [[ "$mapping" =~ ^([1-9][0-9]{0,4}):([1-9][0-9]{0,4})$ ]] && \
        (( 10#${BASH_REMATCH[1]} <= 65535 && 10#${BASH_REMATCH[2]} <= 65535 )) || {
        echo 'sandbox: --publish requires host-port:container-port (1..65535)' >&2; exit 2;
    }
    ports+=(--publish "127.0.0.1:$mapping")
    shift 2
done
if [[ "${1:-}" = -- ]]; then shift; fi
[[ $# -gt 0 ]] || { echo 'sandbox: command required' >&2; exit 2; }
cwd="$(pwd -P)"
case "$cwd" in
    /repo|/repo/*|/home/core|/home/core/*|/data/.db/openchamber|/data/.db/openchamber/*) ;;
    *) echo "sandbox: $cwd is outside mounted roots (/repo /home/core /data/.db/openchamber)" >&2; exit 2 ;;
esac
host_docker image inspect "$image" >/dev/null 2>&1 || {
    echo "sandbox: image $image is missing; build docker/sandbox or pull the published image first" >&2
    exit 1
}
install -d -m 0700 -o "$uid" -g "$gid" "$data/cache" "$data/tmp"
tmp="$(mktemp -d "$data/tmp/run-XXXXXXXXXX")"
name="sandbox-$(basename "$tmp")"
exec 9>"$tmp/.lock"
flock 9
chown "$uid:$gid" "$tmp/.lock"
chmod 0600 "$tmp/.lock"
install -d -m 0700 -o "$uid" -g "$gid" "$tmp" "$tmp/home" \
    "$tmp/xdg-cache" "$tmp/xdg-config" "$tmp/xdg-data" "$tmp/xdg-state"
cleanup() {
    # rm --force stops remaining descendants before deleting their scratch.
    if ! host_docker rm --force "$name" >/dev/null 2>&1; then
        if ! host_docker info >/dev/null 2>&1 || host_docker container inspect "$name" >/dev/null 2>&1; then
            echo "sandbox: container cleanup unconfirmed; retaining $tmp" >&2
            return
        fi
    fi
    rm -rf -- "$tmp"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

args=(--rm -i --init --cap-drop ALL --security-opt no-new-privileges "${ports[@]}"
    --name "$name" --user "$uid:$gid" --workdir "$cwd"
    --mount type=bind,src=/repo,dst=/repo
    --mount type=bind,src=/home/core,dst=/home/core
    --mount type=bind,src=/data/.db/openchamber,dst=/data/.db/openchamber
    --mount "type=bind,src=$data/cache,dst=/cache"
    --mount "type=bind,src=$tmp,dst=/tmp"
    -e HOME=/tmp/home -e TMPDIR=/tmp -e XDG_CACHE_HOME=/tmp/xdg-cache
    -e XDG_CONFIG_HOME=/tmp/xdg-config -e XDG_DATA_HOME=/tmp/xdg-data
    -e XDG_STATE_HOME=/tmp/xdg-state -e "DOCKER_HOST=unix:///run/user/$uid/docker.sock")
[[ -t 0 && -t 1 ]] && args+=(-t)
socket="/run/user/$uid/docker.sock"
if [[ -S "$socket" ]]; then
    args+=(--mount "type=bind,src=$socket,dst=$socket,readonly" -e "DOCKER_HOST=unix://$socket")
fi
[[ ! -f /home/core/.gitconfig ]] || args+=(-e GIT_CONFIG_GLOBAL=/home/core/.gitconfig)
[[ ! -f /home/core/.npmrc ]] || args+=(-e npm_config_userconfig=/home/core/.npmrc)
# Only the launcher owns the lock. An orphan Docker client must not keep it
# locked after SIGKILL; stale cleanup needs to be able to stop that container.
host_docker run "${args[@]}" "$image" "$@" 9>&- &
client=$!
set +e
wait "$client"
status=$?
set -e
exit "$status"
